#!/usr/bin/env bash
# Versioned git hooks for this repo (core.hooksPath = .githooks).
# One-time setup per clone:  git config core.hooksPath .githooks
# (Claude Code hooks live in scripts/hooks/ — a different thing; don't mix them.)
#
# 1) SOUL drift advisory — runs on every commit, never blocks.
# 2) Style digest freshness — the `# ratchet:begin` block at the bottom, installed and refreshed
#    by `ratchet init`. It BLOCKS the commit when the staged CODING-STYLE.md and its compiled
#    outputs (CODING-STYLE.digest.md + the injected blocks in .ratchet.json inject_targets) disagree;
#    hand edits inside an injected block count as stale. If the ratchet interpreter/script recorded
#    in the block is missing it warns loudly and does not block — re-run `ratchet init` to refresh.
#    Proof test (CODING-STYLE R.7): bash .githooks/tests/test_pre_commit_digest_guard.sh
#
# Keep every `exit` out of this file above the ratchet block: `ratchet init` appends its block at
# the end, so an early `exit 0` silently turns the guard into dead code.
# Skip once: git commit --no-verify

ROOT="$(git rev-parse --show-toplevel)"
DRIFT_SCRIPT="$ROOT/scripts/drift-check.sh"

if [ -f "$DRIFT_SCRIPT" ]; then
    bash "$DRIFT_SCRIPT" || true
fi

# ratchet:begin
# Installed by `ratchet init`; portable (no machine-specific paths), so it is safe to commit. Delete this block to uninstall.
# The tool is $RATCHET_BIN, else `bin` in .ratchet.json (relative to the repo root), else `ratchet` on PATH.
# Python is $RATCHET_PY, else python3 on PATH; it must be 3.10 or newer.
if [ -n "${RATCHET_HOOK_PROBE:-}" ]; then
  echo "ratchet-hook-probe pre-commit"
  exit 0
fi
# core.hooksPath can point many repos at one hooks directory; only repos with a config use ratchet.
if [ -f .ratchet.json ]; then
  RATCHET_PY="${RATCHET_PY:-python3}"
  if "$RATCHET_PY" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
    if [ -z "${RATCHET_BIN:-}" ]; then
      RATCHET_BIN=$("$RATCHET_PY" -c 'import json; print(json.load(open(".ratchet.json")).get("bin", ""))' 2>/dev/null || true)
      if [ -z "$RATCHET_BIN" ]; then
        RATCHET_BIN=$(command -v ratchet || true)
      fi
    fi
    if [ -f "$RATCHET_BIN" ]; then
      "$RATCHET_PY" "$RATCHET_BIN" compile --check --staged >/dev/null || exit 1
    else
      printf '%s\n' "ratchet: WARNING: cannot find the ratchet executable (set RATCHET_BIN, add \"bin\" to .ratchet.json, or put ratchet on PATH); pre-commit is NOT running." >&2
    fi
  else
    printf '%s\n' "ratchet: WARNING: $RATCHET_PY is missing or older than Python 3.10 (set RATCHET_PY to a 3.10+ interpreter); pre-commit is NOT running." >&2
  fi
fi
# ratchet:end
