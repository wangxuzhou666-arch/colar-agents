#!/usr/bin/env bash

# house-rules:begin
# Installed by `house-rules init`; portable (no machine-specific paths), so it is safe to commit. Delete this block to uninstall.
# The tool is $HOUSE_RULES_BIN, else `bin` in .house-rules.json (relative to the repo root), else `house-rules` on PATH.
# Python is $HOUSE_RULES_PY, else python3 on PATH; it must be 3.10 or newer.
if [ -n "${HOUSE_RULES_HOOK_PROBE:-}" ]; then
  echo "house-rules-hook-probe pre-commit"
  exit 0
fi
# core.hooksPath can point many repos at one hooks directory; only repos with a config use house-rules.
if [ -f .house-rules.json ]; then
  _house_rules_py="${HOUSE_RULES_PY:-python3}"
  if "$_house_rules_py" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
    _house_rules_bin="${HOUSE_RULES_BIN:-}"
    if [ -z "$_house_rules_bin" ]; then
      _house_rules_bin=$("$_house_rules_py" -c 'import json; print(json.load(open(".house-rules.json")).get("bin", ""))' 2>/dev/null || true)
      if [ -z "$_house_rules_bin" ]; then
        _house_rules_bin=$(command -v house-rules || true)
      fi
    fi
    if [ -f "$_house_rules_bin" ]; then
      "$_house_rules_py" "$_house_rules_bin" compile --check --staged >/dev/null || exit 1
    else
      printf '%s\n' "house-rules: WARNING: cannot find the house-rules executable (set HOUSE_RULES_BIN, add \"bin\" to .house-rules.json, or put house-rules on PATH); pre-commit is NOT running." >&2
    fi
  else
    printf '%s\n' "house-rules: WARNING: $_house_rules_py is missing or older than Python 3.10 (set HOUSE_RULES_PY to a 3.10+ interpreter); pre-commit is NOT running." >&2
  fi
fi
unset _house_rules_py _house_rules_bin
# house-rules:end

# Versioned git hooks for this repo (core.hooksPath = .githooks).
# One-time setup per clone:  git config core.hooksPath .githooks
# (Claude Code hooks live in scripts/hooks/ — a different thing; don't mix them.)
#
# 1) SOUL drift advisory — runs on every commit, never blocks.
# 2) Style digest freshness — the `# house-rules:begin` block at the top, installed and refreshed
#    by `house-rules init`. It BLOCKS the commit when the staged CODING-STYLE.md and its compiled
#    outputs (CODING-STYLE.digest.md + the injected blocks in .house-rules.json inject_targets) disagree;
#    hand edits inside an injected block count as stale. If house-rules or a 3.10+ Python cannot be
#    found it warns loudly and does not block — set HOUSE_RULES_BIN or put house-rules on PATH.
#    Proof test (CODING-STYLE R.7): bash .githooks/tests/test_pre_commit_digest_guard.sh
#
# Keep every `exit` out of this file above the house-rules block: `house-rules init` puts its block
# right under the shebang, and an early `exit 0` above it silently turns the guard into dead code.
# Skip once: git commit --no-verify

ROOT="$(git rev-parse --show-toplevel)"
DRIFT_SCRIPT="$ROOT/scripts/drift-check.sh"

if [ -f "$DRIFT_SCRIPT" ]; then
    bash "$DRIFT_SCRIPT" || true
fi

